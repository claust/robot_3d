# Copy to .testflight.env (gitignored) for local TestFlight uploads.
# The AuthKey_<ASC_KEY_ID>.p8 file itself goes in ~/.private_keys/.
# From App Store Connect -> Users and Access -> Integrations -> Team Keys:
ASC_KEY_ID=
ASC_ISSUER_ID=
# Apple Developer team id (Membership page):
DEVELOPMENT_TEAM=
