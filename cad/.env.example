# Copy to .env and fill in. The real .env is gitignored — never commit it.
# IP: find the printer on the LAN (or check the router / printer network screen)
# Serial + access code: printer touchscreen -> Settings -> Network (WLAN)
BAMBU_PRINTER_IP=192.168.x.x
BAMBU_PRINTER_SERIAL=XXXXXXXXXXXXXXX
BAMBU_ACCESS_CODE=
